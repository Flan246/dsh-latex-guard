{
  "name": "dsh-latex-guard",
  "version": "0.1.1",
  "description": "LaTeX compile check and BibTeX lint/fill/audit tools for DeepSeek Harness and any agent.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/plugin.js",
  "types": "./dist/plugin.d.ts",
  "bin": {
    "dsh-latex-guard": "./dist/cli.js"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "skill",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Flan246/dsh-latex-guard.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "latex",
    "bibtex",
    "lint",
    "crossref"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "prepack": "tsdown"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dependencies": {
    "commander": "^14.0.0",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.1",
    "@types/node": "^24.0.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
